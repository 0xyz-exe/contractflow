# ContractFlow Environment Variables
# Database Configuration
DATABASE_URL=sqlite:///./contractflow.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://contractflow:password@localhost:5432/contractflow_db

# Security & Session Authentication
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage Configuration
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25

# ==============================================================================
# EXTERNAL SMTP / NOTIFICATION PROVIDERS
# ==============================================================================
# Set to 'true' to enable outbound email delivery (false will log preview to console)
SMTP_ENABLED=false
SMTP_FROM=no-reply@contractflow.org
SMTP_TLS=true

# --- OPTION A: SendGrid ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.your_sendgrid_api_key_here

# --- OPTION B: Amazon SES (Simple Email Service) ---
# Replace us-east-1 with your verified SES AWS region
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=AKIAIOSFODNN7EXAMPLE
# SMTP_PASSWORD=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# --- OPTION C: Local Development Mailcatcher / Mailpit ---
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=false

# ==============================================================================
# PRODUCTION DOMAIN & TLS (Caddy / Nginx)
# ==============================================================================
DOMAIN_NAME=clm.yourdomain.com
ACME_EMAIL=admin@yourdomain.com
