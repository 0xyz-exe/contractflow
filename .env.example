# ContractFlow Environment Variables
# Database Configuration
DATABASE_URL=sqlite:///./contractflow.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://contractflow:password@localhost:5432/contractflow_db

# Security & Session Authentication
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage Configuration
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25

# Optional SMTP Settings for Notifications
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=no-reply@contractflow.org
